# PostgreSQL connection (same values you use in Navicat)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fund_clan

# Sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Seeded by npm run db:setup
SUPER_ADMIN_NAME=System Owner
SUPER_ADMIN_PHONE=02099999999
SUPER_ADMIN_PASSWORD=ChangeMe123
